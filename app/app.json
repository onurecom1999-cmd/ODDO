{
  "expo": {
    "name": "ODDO",
    "slug": "oddo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.oddo.coach"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.oddo.coach"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "ODDO",
      "shortName": "ODDO",
      "themeColor": "#0b0b0a",
      "backgroundColor": "#0b0b0a"
    },
    "backgroundColor": "#0a0a0a",
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "ODDO uses your photos for meal estimates, progress photos and your day card.",
          "cameraPermission": "ODDO uses the camera to estimate meals and take progress photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ODDO records the route and pace of your runs and rides while you track them."
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#d4ff3a"
        }
      ]
    ]
  }
}
